{
  "name": "zenith-dentist-automation",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "smoke": "node smoke-test.js && node scripts/pipeline-smoke-test.js",
    "smoke:pipeline": "node scripts/pipeline-smoke-test.js",
    "test:e2e": "node scripts/e2e-production-check.js",
    "test:onboarding": "node scripts/certify-dental-onboarding.js",
    "test:flow-os": "node scripts/certify-flow-orchestration.js",
    "test:runtime:contract": "node scripts/certify-runtime-contract.js",
    "certify:runtime:live": "node scripts/certify-runtime-e2e.js",
    "certify:onboarding": "npm run migration:validate && npm run test:e2e && npm run test:onboarding && npm run test:flow-os && npm run test:runtime:contract && npm run typecheck && npm run build",
    "certify:flow-os": "npm run migration:validate && npm run test:flow-os && npm run test:runtime:contract && npm run typecheck && npm run build",
    "migration:validate": "node scripts/validate-migrations.js"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.48.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.468.0",
    "next": "^15.3.3",
    "next-intl": "^4.13.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "resend": "^4.0.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.3.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  }
